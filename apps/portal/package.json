{
  "name": "portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive AI Learning Portal: Vite + React + TypeScript front-end.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "comlink": "4.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.187.0",
    "xstate": "5.33.3",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.187.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "5.2.0",
    "@webgpu/types": "0.1.74",
    "binaryen": "132.0.0",
    "eslint": "8.57.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "4.6.2",
    "javascript-obfuscator": "5.9.1",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-top-level-await": "1.6.0",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "3.2.7"
  }
}
